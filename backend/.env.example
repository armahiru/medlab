# MediChain Backend Environment
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medichain
# Use a long random string for any shared/demo machine
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_ORIGIN=http://localhost:3000

# Optional email — prefer Resend on Render (HTTPS; Gmail SMTP often times out there)
# https://resend.com — free API key
RESEND_API_KEY=
RESEND_FROM=MediChain <onboarding@resend.dev>

# Optional local SMTP (Gmail App Password) — works on many home networks
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional SMS via Twilio (https://www.twilio.com — leave blank = in-app only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional Cloudinary (https://cloudinary.com — leave blank = local uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medichain
